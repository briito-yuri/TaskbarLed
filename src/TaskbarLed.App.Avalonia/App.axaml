<!--
  Application resources. The Led.* keys mirror the WPF themes (src/TaskbarLed.App/Themes/Matrix.xaml documents them);
  fallback values are used before a theme is applied.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskbarLed.App.Avalonia.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <Style Selector="ContextMenu.taskbarled-panel-menu">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="214" />
      <Setter Property="CornerRadius" Value="{DynamicResource Led.PanelRadius}" />
      <Setter Property="FontFamily" Value="{DynamicResource Led.FontFamily}" />
    </Style>
    <Style Selector="MenuItem.taskbarled-theme-option">
      <Setter Property="FontFamily" Value="Helvetica Neue" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="MenuItem.taskbarled-menu-heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="MenuItem.taskbarled-menu-heading /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Led.MenuAccentBrush}" />
    </Style>
    <Style Selector="MenuItem.taskbarled-menu-quit">
      <Setter Property="Background" Value="{DynamicResource Led.MenuQuitBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HeaderTemplate">
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="*,Auto" MinWidth="160">
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            <Path Grid.Column="1" Width="14" Height="14" Margin="16,0,0,0"
                  Stroke="{DynamicResource Led.MenuAccentBrush}" StrokeThickness="1.4"
                  Stretch="Uniform" VerticalAlignment="Center"
                  Data="M 8,1 L 8,7 M 4,3 A 6,6 0 1 0 12,3" />
          </Grid>
        </DataTemplate>
      </Setter>
    </Style>
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#F2020A02" />
    <SolidColorBrush x:Key="Led.BorderBrush" Color="#0F3D12" />
    <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#33FF66" />
    <SolidColorBrush x:Key="Led.DimBrush" Color="#1FAE47" />
    <SolidColorBrush x:Key="Led.AttentionBrush" Color="#FFB02E" />
    <SolidColorBrush x:Key="Led.DoneBrush" Color="#33FF66" />
    <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#0B2A0E" />
    <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#33FF66" />
    <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#33FF66" />
    <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.SessionRailBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.SessionChildBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#33FF66" />
    <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.BrandBackdropBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.CompletionBrush" Color="#BFE6C8" />
    <SolidColorBrush x:Key="Led.CompletionTint" Color="#55BFE6C8" />
    <CornerRadius x:Key="Led.PanelRadius">4</CornerRadius>
    <Thickness x:Key="Led.FrameThickness">1</Thickness>
    <SolidColorBrush x:Key="Led.EditBrush" Color="#D97757" />
    <SolidColorBrush x:Key="Led.AccentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Led.PanelSurfaceBrush" Color="#F2020A02" />
    <Thickness x:Key="Led.PanelPadding">5,2,7,1</Thickness>
    <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
    <x:Double x:Key="Led.GlowOpacity">0.75</x:Double>
    <Color x:Key="Led.GlowColor">#33FF66</Color>
    <!-- Menlo and SF Mono ship with macOS; the rest cover Windows and Linux. -->
    <FontFamily x:Key="Led.FontFamily">Menlo, SF Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
  </Application.Resources>

</Application>
