<!--
  The panel's look on Avalonia: session tabs, feed line and timer, blinking outline.
  Mirrors src/TaskbarLed.App/Panels/PanelView.xaml (WPF). Colors come from the Led.* resources.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskbarLed.App.Avalonia.Presentation"
             xmlns:panels="using:TaskbarLed.App.Avalonia.Panels"
             x:Class="TaskbarLed.App.Avalonia.Panels.PanelView"
             x:DataType="vm:PanelViewModel">

  <UserControl.Styles>
    <!-- Hard on/off blink, like a real LED. -->
    <Style Selector=":is(Control).blink">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="49%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.session-row">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.session-row.header">
      <Setter Property="Background" Value="{DynamicResource Led.SessionHeaderBrush}" />
    </Style>
    <Style Selector="TextBlock.session-label">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.session-row.header TextBlock.session-label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionTitleBrush}" />
    </Style>
    <Style Selector="Border.session-row.child">
      <Setter Property="Background" Value="{DynamicResource Led.SessionChildBrush}" />
    </Style>
    <Style Selector="Border.session-row.child TextBlock.session-label">
      <Setter Property="Margin" Value="9,0,8,0" />
    </Style>
    <Style Selector="TextBlock.session-status">
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionRunningBrush}" />
    </Style>
    <Style Selector="TextBlock.session-status.waiting">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <Style Selector="TextBlock.session-status.done">
      <Setter Property="Foreground" Value="{DynamicResource Led.DoneBrush}" />
    </Style>

    <Style Selector="Border.tab">
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="{DynamicResource Led.ChannelOffBrush}" />
    </Style>
    <Style Selector="Border.tab TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Led.FontFamily}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Led.DimBrush}" />
    </Style>
    <Style Selector="Border.tab.running TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.tab.completed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.DoneBrush}" />
    </Style>
    <Style Selector="Border.tab.awaiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <!-- Selected tab: lit outline, bold text. Declared after the status colors so it wins. -->
    <Style Selector="Border.tab.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.tab.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.tab.selected.awaiting">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <Style Selector="Border.tab.selected.awaiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>

    <Style Selector="TextBlock.feed">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.feed.attention">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>

    <Style Selector="Border.halo">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Led.DoneBrush}" />
    </Style>
    <Style Selector="Border.halo.attention">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border CornerRadius="4" BorderThickness="1"
            Background="{DynamicResource Led.BackgroundBrush}"
            BorderBrush="{DynamicResource Led.BorderBrush}" />

    <Grid Margin="6,3,8,2" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">
      <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Channels}" IsVisible="{Binding !HasSubagents}" ClipToBounds="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <panels:TabStripPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChannelViewModel">
            <Border Classes="tab"
                    Classes.running="{Binding IsRunning}"
                    Classes.completed="{Binding IsCompleted}"
                    Classes.awaiting="{Binding IsAwaiting}"
                    Classes.selected="{Binding IsSelected}"
                    Classes.blink="{Binding IsCompleted}">
              <!-- The status mark stays whole; the title gives way when the row is full. -->
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="4,0,0,0" Text="{Binding Glyph}" />
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True" IsVisible="{Binding !HasSubagents}">
        <TextBlock DockPanel.Dock="Left" Classes.pulse="{Binding FeedIsRunning}" Text="{DynamicResource Led.FeedPrefix}" Foreground="{DynamicResource Led.AccentBrush}"
                   VerticalAlignment="Center" FontSize="14" FontFamily="{DynamicResource Led.FontFamily}" />
        <TextBlock Margin="3,0,0,0" Classes="feed" Classes.attention="{Binding FeedIsAttention}"
                 Text="{Binding Feed}" VerticalAlignment="Center"
                 FontFamily="{DynamicResource Led.FontFamily}" FontSize="13" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis">
        <TextBlock.Effect>
          <DropShadowEffect Color="{DynamicResource Led.GlowColor}" BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="{DynamicResource Led.GlowOpacity}" />
        </TextBlock.Effect>
        </TextBlock>
      </DockPanel>

      <!-- Prompt timer on the feed's line, so the tabs get the whole top row for chat titles. -->
      <TextBlock Grid.Row="1" Grid.Column="1" IsVisible="{Binding !HasSubagents}" Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                 FontFamily="{DynamicResource Led.FontFamily}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource Led.ForegroundBrush}" />
      <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding HasSubagents}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding SessionRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionDisplayRowViewModel">
              <Border Classes="session-row" Classes.header="{Binding IsHeader}" Classes.child="{Binding IsChild}">
                <Grid ColumnDefinitions="6,Auto,*,Auto" Margin="2,0,6,0">
                  <Border Grid.Column="0" IsVisible="{Binding IsHeader}" Width="3" Margin="0,3,2,3"
                          Background="{DynamicResource Led.SessionRailBrush}" CornerRadius="1" />
                  <Border Grid.Column="1" IsVisible="{Binding IsChild}" Width="1" Margin="6,0,0,0"
                          Background="{DynamicResource Led.SessionTreeBrush}" />
                  <TextBlock Grid.Column="2" Classes="session-label" Text="{Binding Label}" ToolTip.Tip="{Binding Label}"
                             FontFamily="{DynamicResource Led.FontFamily}"
                             VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Classes="session-status" Classes.waiting="{Binding IsWaiting}" Classes.done="{Binding IsDone}"
                             Text="{Binding Status}" FontFamily="{DynamicResource Led.FontFamily}" FontSize="10.5"
                             VerticalAlignment="Center" Margin="6,0,1,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Background="{DynamicResource Led.DotGridBrush}" CornerRadius="4" IsHitTestVisible="False" />

    <!-- Outline that blinks green while a finished session waits to be seen, amber when one waits for you. -->
    <Border Classes="halo" Classes.blink="{Binding IsBlinking}"
            CornerRadius="4" BorderThickness="1.5" IsHitTestVisible="False" />
    <Border Classes="halo attention" Classes.blink="{Binding NeedsAttention}"
            CornerRadius="4" BorderThickness="1.5" IsHitTestVisible="False" />
  </Panel>
</UserControl>
