<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#1C1D18" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#424237" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#EEEADB" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#A9AA9C" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#ECC788" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#9CB494" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#1C1D18" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#DDB06D" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#DDB06D" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#E2B171" />
  <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#DDB06D" />
  <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#DDB06D" />
  <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionRailBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="#48483B" />
  <SolidColorBrush x:Key="Led.SessionChildBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="Transparent" />
  <Color x:Key="Led.GlowColor">Transparent</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <FontFamily x:Key="Led.FontFamily">Menlo, Consolas, Courier New</FontFamily>
  <sys:Double x:Key="Led.PanelRadius">6</sys:Double>
</ResourceDictionary>
