<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#20221F" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#4A4E45" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#DEDFD1" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#A8AD9F" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#F2CD8F" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#AABE9D" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#20221F" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#E2B076" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#E2B076" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#F2EFDC" />
  <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#E2B076" />
  <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#E2B076" />
  <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionRailBrush" Color="#B88953" />
  <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionChildBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="#30342E" />
  <Color x:Key="Led.GlowColor">Transparent</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <FontFamily x:Key="Led.FontFamily">Menlo, Consolas, Courier New</FontFamily>
  <sys:Double x:Key="Led.PanelRadius">7</sys:Double>
</ResourceDictionary>
