<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#A7B88C" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#292D27" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#243321" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#3E5037" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#443E24" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#2A4B2C" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#A7B88C" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#243321" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#243321" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#243321" />
