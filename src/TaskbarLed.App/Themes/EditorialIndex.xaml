<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#FFFDF7" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#D8D0C5" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#302823" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#65554F" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#8A461E" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#526952" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#FFFDF7" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#782E29" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#782E29" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#36251F" />
  <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#782E29" />
  <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#782E29" />
  <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionRailBrush" Color="#9A332C" />
  <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionChildBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="#E7DFD4" />
  <Color x:Key="Led.GlowColor">Transparent</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <FontFamily x:Key="Led.FontFamily">Georgia, Consolas, Courier New</FontFamily>
  <sys:Double x:Key="Led.PanelRadius">0</sys:Double>
</ResourceDictionary>
