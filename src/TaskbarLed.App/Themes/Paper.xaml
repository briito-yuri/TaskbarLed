<!--
  Theme "Paper": light card with dark text, for a light taskbar.
  Every theme defines the same Led.* keys. See Matrix.xaml for what each one controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#F7F9F9F9" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#D4D4D4" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#1B1B1B" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#5C5C5C" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#B35900" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#E8E8E8" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#005FB8" />
  <Color x:Key="Led.GlowColor">#00000000</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <FontFamily x:Key="Led.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- No LED dots. -->
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />

</ResourceDictionary>
