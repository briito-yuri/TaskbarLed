<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#F8F8F2" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#DAE1DA" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#222D2D" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#526866" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#865511" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#4F6D50" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#F8F8F2" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#176B64" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#176B64" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#222D2D" />
  <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#176B64" />
  <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#176B64" />
  <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionRailBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionChildBrush" Color="#EEEFEB" />
  <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="Transparent" />
  <Color x:Key="Led.GlowColor">Transparent</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <FontFamily x:Key="Led.FontFamily">Helvetica Neue, Consolas, Courier New</FontFamily>
  <sys:Double x:Key="Led.PanelRadius">12</sys:Double>
</ResourceDictionary>
