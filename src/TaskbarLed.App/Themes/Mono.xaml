<!--
  Theme "Mono": black and white terminal, monospaced, no glow.
  Every theme defines the same Led.* keys. See Matrix.xaml for what each one controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#F2000000" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#2E2E2E" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#8C8C8C" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#FFB547" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#FFFFFF" />
  <Color x:Key="Led.GlowColor">#00000000</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <FontFamily x:Key="Led.FontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- No LED dots. -->
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />

  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="Transparent" />

</ResourceDictionary>
