<!--
  Theme "Minimal": dark card, clean type, no LED effects. Fits any desktop.
  Every theme defines the same Led.* keys. See Matrix.xaml for what each one controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#F2202020" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#A0A0A0" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#FFB547" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#333333" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#60CDFF" />
  <Color x:Key="Led.GlowColor">#00000000</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <FontFamily x:Key="Led.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- No LED dots. -->
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />

  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="Transparent" />

</ResourceDictionary>
